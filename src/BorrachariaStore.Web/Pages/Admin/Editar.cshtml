@page "{id}"
@model BorrachariaStore.Web.Pages.Admin.EditarModel
@{
    ViewData["Title"] = "Editar Produto";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="admin-card-edit">
    <div class="admin-card-header">
        <h2>Editar Produto</h2>
        <a asp-page="/Admin/Index" class="admin-card-back">← Voltar</a>
    </div>

    <form method="post">
        <div asp-validation-summary="All" class="admin-validation-summary"></div>
        <!-- Campo oculto obrigatório para manter o ID do produto no MongoDB -->
        <input type="hidden" asp-for="Produto.Id" />
        <div class="form-group">
            <label asp-for="Produto.Nome" class="form-label">Nome</label>
            <input asp-for="Produto.Nome" class="form-input" required />
        </div>
        <div class="form-group">
            <label asp-for="Produto.Marca" class="form-label">Marca</label>
            <input asp-for="Produto.Marca" class="form-input" required />
        </div>

        <div class="form-group">
            <label asp-for="Produto.Categoria" class="form-label">Categoria</label>
            <input asp-for="Produto.Categoria" class="form-input" placeholder="Ex: Passeio, SUV, Carga" />
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Produto.Medida" class="form-label">Medida</label>
                <input asp-for="Produto.Medida" class="form-input" placeholder="Ex: 175/70 R14" />
            </div>

            <div class="form-group">
                <label asp-for="Produto.Aro" class="form-label">Aro</label>
                <input asp-for="Produto.Aro" type="number" class="form-input" required />
            </div>
        </div>
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Produto.Preco" class="form-label">Preço (R$)</label>
                <input asp-for="Produto.Preco" type="number" step="0.01" class="form-input" required />
            </div>

            <div class="form-group">
                <label asp-for="Produto.Estoque" class="form-label">Quantidade em Estoque</label>
                <input asp-for="Produto.Estoque" type="number" class="form-input" required />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Produto.Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Produto.Descricao" rows="3" class="form-input textarea-resizable"></textarea>
        </div>

        <div class="form-actions">
            <a asp-page="/Admin/Index" class="btn-cancel">
                Cancelar
            </a>
            <button type="submit" class="btn-primary-admin">
                Salvar Alterações
            </button>
        </div>
    </form>
</div>
