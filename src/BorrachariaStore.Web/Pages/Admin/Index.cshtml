@page
@model BorrachariaStore.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Painel Administrativo";
}

<!-- Link do CSS moderno exclusivo do Painel Administrativo -->
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="admin-main">
    <!-- CABEÇALHO DO PAINEL -->
    <div class="page-head">
        <div>
            <h1>Gerenciador de Estoque</h1>
            <p>Acompanhe o estoque em tempo real, edite preços ou remova produtos.</p>
        </div>
        <a asp-page="/Admin/Cadastrar" class="btn-primary-admin">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Novo produto
        </a>
    </div>

    <!-- MENSAGENS DE NOTIFICAÇÃO (FEEDBACK AO USUÁRIO) -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div style="background: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null || !string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
            @(TempData["MensagemErro"] ?? Model.MensagemErro)
        </div>
    }

    <!-- BARRA DE PESQUISA E FILTROS -->
    <div class="toolbar">
        <div class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" placeholder="Buscar por produto, aro ou marca..." />
        </div>
        <select class="filter-select">
            <option>Todos os aros</option>
            <option>Aro 13</option>
            <option>Aro 14</option>
            <option>Aro 15</option>
            <option>Aro 16</option>
            <option>Aro 17</option>
            <option>Aro 18</option>
        </select>
        <select class="filter-select">
            <option>Todos os status</option>
            <option>Ativo</option>
            <option>Baixo estoque</option>
            <option>Inativo</option>
        </select>
    </div>

    <!-- TABELA DE PRODUTOS -->
    <div class="table-wrap">
        @if (!Model.Produtos.Any())
        {
            <div style="padding: 40px; text-align: center; color: var(--gray-600);">
                Nenhum produto cadastrado no momento.
            </div>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Estoque</th>
                        <th>Status</th>
                        <th style="text-align:right;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Produtos)
                    {
                        <tr>
                            <td>
                                <div class="prod-cell">
                                    <div class="prod-thumb">
                                        @if (!string.IsNullOrWhiteSpace(p.UrlFoto))
                                        {
                                            <img src="@p.UrlFoto" alt="@p.Nome" class="prod-thumb-img" />
                                        }
                                        else
                                        {
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="9" />
                                                <circle cx="12" cy="12" r="3.2" />
                                            </svg>
                                        }
                                    </div>
                                    <div>
                                        <div class="prod-name">@p.Nome</div>
                                        <div class="prod-size">@(string.IsNullOrEmpty(p.Medida) ? $"Aro {p.Aro}" : p.Medida) • @p.Preco.ToString("C")</div>
                                    </div>
                                </div>
                            </td>
                            <td class="@(p.Estoque <= 5 ? "stock-low" : "")">@p.Estoque un</td>
                            <td>
                                <span class="status-dot @(p.Estoque > 0 ? "status-ativo" : "status-inativo")">
                                    @(p.Estoque > 0 ? "Ativo" : "Inativo")
                                </span>
                            </td>
                            <td>
                                <div class="actions" style="justify-content:flex-end;">
                                    <!-- Botão Editar: Abre o modal CSS sem JavaScript -->
                                    <a href="#editar-@p.Id" class="icon-btn edit" title="Editar Produto">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                            <path d="m15 5 4 4"/>
                                        </svg>
                                    </a>
                                    <!-- Botão Excluir: Abre o modal de confirmação CSS sem JavaScript -->
                                    <a href="#excluir-@p.Id" class="icon-btn delete" title="Excluir Produto">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 6h18"/>
                                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                            <line x1="10" x2="10" y1="11" y2="17"/>
                                            <line x1="14" x2="14" y1="11" y2="17"/>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>

                        <!-- MODAL DE EDIÇÃO DO PRODUTO (100% HTML + CSS PURO) -->
                        <div class="overlay" id="editar-@p.Id">
                            <div class="modal">
                                <div class="modal-head">
                                    <div>
                                        <h2>Editar produto</h2>
                                        <p>@p.Nome</p>
                                    </div>
                                    <a href="#" class="modal-close" aria-label="Fechar">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </a>
                                </div>

                                <form method="post" asp-page-handler="Editar" enctype="multipart/form-data">
                                    <input type="hidden" name="Produto.Id" value="@p.Id" />
                                    <input type="hidden" name="Produto.UrlFoto" value="@p.UrlFoto" />

                                    <div class="modal-body">
                                        <div class="row-2">
                                            <div class="field">
                                                <label>Nome do produto</label>
                                                <input type="text" name="Produto.Nome" value="@p.Nome" required />
                                            </div>
                                            <div class="field">
                                                <label>Marca</label>
                                                <select name="Produto.Marca" required>
                                                    @if (!string.IsNullOrWhiteSpace(p.Marca))
                                                    {
                                                        <option value="@p.Marca">@p.Marca (Atual)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="">Selecione uma marca...</option>
                                                    }
                                                    <option value="Pirelli">Pirelli</option>
                                                    <option value="Michelin">Michelin</option>
                                                    <option value="Goodyear">Goodyear</option>
                                                    <option value="Continental">Continental</option>
                                                    <option value="Bridgestone">Bridgestone</option>
                                                    <option value="Firestone">Firestone</option>
                                                    <option value="Dunlop">Dunlop</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row-3">
                                            <div class="field">
                                                <label>Medida</label>
                                                <input type="text" name="Produto.Medida" value="@p.Medida" placeholder="Ex: 175/70 R14" required />
                                            </div>
                                            <div class="field">
                                                <label>Aro</label>
                                                <input type="number" name="Produto.Aro" value="@p.Aro" placeholder="14" required />
                                            </div>
                                            <div class="field">
                                                <label>Categoria</label>
                                                <select name="Produto.Categoria">
                                                    @if (!string.IsNullOrWhiteSpace(p.Categoria))
                                                    {
                                                        <option value="@p.Categoria">@p.Categoria (Atual)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="">Selecione uma categoria...</option>
                                                    }
                                                    <option value="Passeio">Passeio</option>
                                                    <option value="SUV">SUV</option>
                                                    <option value="Carga">Carga</option>
                                                    <option value="Performance">Performance</option>
                                                    <option value="Off-Road">Off-Road</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row-2">
                                            <div class="field">
                                                <label>Preço (R$)</label>
                                                <input type="number" step="0.01" name="Produto.Preco" value="@p.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                            </div>
                                            <div class="field">
                                                <label>Estoque</label>
                                                <input type="number" name="Produto.Estoque" value="@p.Estoque" required />
                                            </div>
                                        </div>

                                        <div class="field">
                                            <label>Descrição</label>
                                            <textarea name="Produto.Descricao" maxlength="500" placeholder="Digite a descrição do produto...">@p.Descricao</textarea>
                                            <div style="display: flex; justify-content: flex-end; margin-top: 4px;">
                                                <span class="char-info">Máx. 500 caracteres (restantes: @(500 - (p.Descricao?.Length ?? 0)))</span>
                                            </div>
                                        </div>

                                        <div class="field">
                                            <label>Fotos do produto (Upload de 1 ou mais arquivos)</label>
                                            <input type="file" name="uploadedImageFiles" accept="image/*" multiple />
                                            @{
                                                var fotosExibicao = (p.Fotos != null && p.Fotos.Count > 0)
                                                    ? p.Fotos
                                                    : (!string.IsNullOrWhiteSpace(p.UrlFoto) ? new List<string> { p.UrlFoto } : new List<string>());
                                            }
                                            @if (fotosExibicao.Count > 0)
                                            {
                                                <div class="gallery-list">
                                                    @foreach (var foto in fotosExibicao)
                                                    {
                                                        <div class="gallery-item">
                                                            <div class="gallery-thumb-box">
                                                                <img src="@foto" alt="" class="gallery-thumb" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                                <div class="gallery-thumb-fallback" style="display:none;">
                                                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                                                                        <circle cx="9" cy="9" r="2"/>
                                                                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                                                                    </svg>
                                                                </div>
                                                            </div>
                                                            <label class="gallery-trash-btn" title="Excluir foto">
                                                                <input type="checkbox" name="fotosParaRemover" value="@foto" />
                                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <path d="M3 6h18" />
                                                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                                    <line x1="10" y1="11" x2="10" y2="17" />
                                                                    <line x1="14" y1="11" x2="14" y2="17" />
                                                                </svg>
                                                            </label>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="modal-footer">
                                        <a href="#" class="btn-secondary">Cancelar</a>
                                        <button type="submit" class="btn-primary-admin">Salvar alterações</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- MODAL DE CONFIRMAÇÃO DE EXCLUSÃO (100% HTML + CSS PURO) -->
                        <div class="overlay" id="excluir-@p.Id">
                            <div class="modal" style="max-width: 440px;">
                                <div class="modal-head">
                                    <div>
                                        <h2>Confirmar Exclusão</h2>
                                    </div>
                                    <a href="#" class="modal-close" aria-label="Fechar">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="18" y1="6" x2="6" y2="18" />
                                            <line x1="6" y1="6" x2="18" y2="18" />
                                        </svg>
                                    </a>
                                </div>
                                <div class="modal-body">
                                    <p style="color: var(--gray-600); font-size: 14px; line-height: 1.5; margin: 0;">
                                        Tem certeza que deseja excluir o pneu <strong style="color: var(--ink);">@p.Nome</strong>?
                                        Esta ação não poderá ser desfeita.
                                    </p>
                                </div>
                                <form method="post" asp-page-handler="Remover" class="modal-footer">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <a href="#" class="btn-secondary">Cancelar</a>
                                    <button type="submit" style="background: var(--red); color: white; border: none; border-radius: 8px; padding: 11px 20px; font-weight: 600; cursor: pointer;">
                                        Sim, Excluir
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        }
    </div>
</div>


