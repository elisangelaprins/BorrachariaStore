@page
@model BorrachariaStore.Web.Pages.CarrinhoModel
@{
  ViewData["Title"] = "Meu Carrinho";
}

<link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />

<a href="javascript:history.back()" class="cart-drawer-overlay"></a>

<div class="cart-drawer">
  <div class="cart-drawer-header">
    <div class="cart-box-title">
      <svg class="icon cart-header-icon" viewBox="0 0 24 24">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
      <h2>Meu Carrinho <span class="cart-count">(@(Model.Itens?.Sum(i => i.Quantidade) ?? 0))</span></h2>
    </div>
    <a href="javascript:history.back()" class="cart-close-btn" title="Fechar">&times;</a>
  </div>

  @if (Model.Itens != null && Model.Itens.Any())
  {
    <div class="cart-drawer-body">
      @foreach (var item in Model.Itens)
      {
        <div class="cart-item-row">
          <div class="cart-item-thumb">
            @if (!string.IsNullOrWhiteSpace(item.UrlFoto))
            {
              <img src="@(item.UrlFoto.StartsWith("/") ? item.UrlFoto : "/" + item.UrlFoto)" alt="@item.Nome"
                   onerror="this.onerror=null; this.src='/images/logo/logo-icon.png'; this.classList.add('cart-thumb-fallback');" />
            }
            else
            {
              <img src="/images/logo/logo-icon.png" alt="@item.Nome" class="cart-thumb-fallback" />
            }
          </div>

          <div class="cart-item-details">
            <div class="cart-item-header">
              <span class="cart-item-title">@item.Nome</span>
              <form method="post" asp-page-handler="Remover">
                <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                <button type="submit" class="cart-btn-remover" title="Remover item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18" />
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                    <line x1="10" y1="11" x2="10" y2="17" />
                    <line x1="14" y1="11" x2="14" y2="17" />
                  </svg>
                </button>
              </form>
            </div>

            <span class="cart-item-subtitle">Preço Unitário: R$ @item.PrecoUnitario.ToString("N2")</span>

            <div class="cart-item-bottom">
              <div class="cart-qty-controls">
                <form method="post" asp-page-handler="AtualizarQuantidade">
                  <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                  <input type="hidden" name="quantidade" value="@(item.Quantidade - 1)" />
                  <button type="submit" class="cart-btn-qty" title="Diminuir">-</button>
                </form>

                <span class="cart-item-qty-badge">Qtd: <strong>@item.Quantidade</strong></span>

                <form method="post" asp-page-handler="AtualizarQuantidade">
                  <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                  <input type="hidden" name="quantidade" value="@(item.Quantidade + 1)" />
                  <button type="submit" class="cart-btn-qty" title="Aumentar">+</button>
                </form>
              </div>

              <span class="cart-item-price">R$ @item.Subtotal.ToString("N2")</span>
            </div>
          </div>
        </div>
      }
    </div>

    <div class="cart-drawer-footer">
      @if (TempData["MensagemSucessoCupom"] != null)
      {
        <div class="cart-msg-success">
          @TempData["MensagemSucessoCupom"]
        </div>
      }
      @if (TempData["MensagemErroCupom"] != null)
      {
        <div class="cart-msg-error">
          @TempData["MensagemErroCupom"]
        </div>
      }

      @if (Model.Cupom == null)
      {
        <form method="post" asp-page-handler="AplicarCupom" class="coupon-box">
          <input type="text" name="cupom" placeholder="Cupom de desconto" class="coupon-input" required />
          <button type="submit" class="coupon-btn">Aplicar</button>
        </form>
      }
      else
      {
        <div class="coupon-box coupon-applied">
          <span class="coupon-applied-text">
            Cupom @Model.Cupom.Codigo ativo (-@Model.Cupom.PorcentagemDesconto%)
          </span>
          <form method="post" asp-page-handler="RemoverCupom" class="coupon-remove-form">
            <button type="submit" class="coupon-remove-btn">
              Remover
            </button>
          </form>
        </div>
      }

      <div class="summary-line-row">
        <span>Subtotal (@Model.Itens.Sum(i => i.Quantidade) itens)</span>
        <span>R$ @Model.Subtotal.ToString("N2")</span>
      </div>

      @if (Model.Desconto > 0)
      {
        <div class="summary-line-row summary-discount">
          <span>Desconto (@Model.Cupom?.Codigo)</span>
          <span>- R$ @Model.Desconto.ToString("N2")</span>
        </div>
      }

      <div class="summary-line-row">
        <span>Frete</span>
        @if (Model.Frete == 0)
        {
          <span class="free-shipping">Grátis</span>
        }
        else
        {
          <span class="shipping-cost">R$ @Model.Frete.ToString("N2")</span>
        }
      </div>

      <div class="summary-total-row">
        <span>Total</span>
        <span class="total-amount">R$ @Model.Total.ToString("N2")</span>
      </div>

      <a asp-page="/Checkout" class="btn btn-primary btn-checkout-full">Finalizar compra</a>
      <a href="javascript:history.back()" class="btn-continue-link">Continuar comprando</a>
    </div>
  }
  else
  {
    <div class="empty-cart-card">
      <p>Seu carrinho está vazio.</p>
      <a asp-page="/Catalogo" class="btn btn-primary">Ver Catálogo</a>
    </div>
  }
</div>