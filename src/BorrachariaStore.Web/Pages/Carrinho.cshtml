@page
@model BorrachariaStore.Web.Pages.CarrinhoModel
@{
    ViewData["Title"] = "Meu Carrinho";
}

<style>
.cart-drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(11, 18, 32, 0.7);
  backdrop-filter: blur(4px);
  z-index: 9998;
}

.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 440px;
  height: 100vh;
  background: #ffffff;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  box-shadow: -8px 0 30px rgba(0, 0, 0, 0.25);
  animation: slideInRight 0.25s ease-out;
}

@@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

.cart-drawer-header {
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e2e8f0;
}

.cart-box-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cart-box-title h2 {
  font-size: 20px;
  font-weight: 800;
  margin: 0;
  color: #0f172a;
}

.cart-count {
  font-size: 15px;
  font-weight: 500;
  color: #64748b;
}

.cart-close-btn {
  font-size: 28px;
  line-height: 1;
  color: #64748b;
  cursor: pointer;
  padding: 2px 8px;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.15s;
}

.cart-close-btn:hover {
  color: #0f172a;
  background: #f1f5f9;
}

.cart-drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.cart-item-row {
  display: flex;
  gap: 14px;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #f1f5f9;
}

.cart-item-row:last-child {
  border-bottom: none;
}

.cart-item-thumb {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  background: #eef2fb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cart-tire-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 4px solid #2563eb;
  position: relative;
}

.cart-tire-icon::after {
  content: "";
  position: absolute;
  inset: 0;
  margin: auto;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #2563eb;
}

.cart-item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.cart-item-title {
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
}

.cart-item-subtitle {
  font-size: 13px;
  color: #64748b;
}

.cart-item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6px;
}

.cart-item-qty-badge {
  font-size: 12px;
  color: #475569;
  background: #f8fafc;
  padding: 3px 8px;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
}

.cart-item-price {
  font-size: 16px;
  font-weight: 800;
  color: #0f172a;
}

.cart-drawer-footer {
  padding: 20px 24px 24px;
  border-top: 1px solid #e2e8f0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.coupon-box {
  display: flex;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 4px 6px;
  margin-bottom: 6px;
}

.coupon-input {
  border: none;
  background: transparent;
  outline: none;
  padding: 8px 10px;
  flex: 1;
  font-size: 14px;
}

.coupon-btn {
  background: transparent;
  border: none;
  color: #2563eb;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  padding: 0 12px;
}

.coupon-btn:hover {
  color: #1d4ed8;
}

.summary-line-row {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.free-shipping {
  color: #16a34a;
  font-weight: 700;
}

.summary-total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 10px;
  border-top: 1px solid #f1f5f9;
  font-size: 16px;
  font-weight: 700;
  color: #0f172a;
}

.total-amount {
  font-size: 22px;
  font-weight: 800;
  color: #0f172a;
}

.btn-checkout-full {
  display: block;
  width: 100%;
  text-align: center;
  padding: 13px;
  font-size: 15px;
  font-weight: 700;
  border-radius: 8px;
  margin-top: 6px;
  text-decoration: none;
}

.btn-continue-link {
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #64748b;
  margin-top: 4px;
  display: block;
  text-decoration: none;
}

.btn-continue-link:hover {
  color: #2563eb;
}
</style>

<a asp-page="/Index" class="cart-drawer-overlay"></a>

<!-- GAVETA LATERAL FIXA À DIREITA -->
<div class="cart-drawer">
    <!-- CABEÇALHO -->
    <div class="cart-drawer-header">
        <div class="cart-box-title">
            <svg class="icon" viewBox="0 0 24 24" style="stroke: #0f172a; width: 22px; height: 22px;">
                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <h2>Meu Carrinho <span class="cart-count">(@(Model.Itens?.Sum(i => i.Quantidade) ?? 0))</span></h2>
        </div>
        <!-- BOTÃO FECHAR (X) -->
        <a asp-page="/Index" class="cart-close-btn" title="Fechar">&times;</a>
    </div>

    @if (Model.Itens != null && Model.Itens.Any())
    {
        <!-- LISTA DE PRODUTOS COM SCROLL -->
        <div class="cart-drawer-body">
            @foreach (var item in Model.Itens)
            {
                <div class="cart-item-row">
                    <div class="cart-item-thumb">
                        <div class="cart-tire-icon"></div>
                    </div>

                    <div class="cart-item-details">
                        <span class="cart-item-title">@item.Nome</span>
                        <span class="cart-item-subtitle">Preço Unitário: R$ @item.PrecoUnitario.ToString("N2")</span>
                        <div class="cart-item-bottom">
                            <span class="cart-item-qty-badge">Qtd: <strong>@item.Quantidade</strong></span>
                            <span class="cart-item-price">R$ @item.Subtotal.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- RESUMO FIXO NO RODAPÉ -->
        <div class="cart-drawer-footer">
            <div class="coupon-box">
                <input type="text" placeholder="Cupom de desconto" class="coupon-input" />
                <button type="button" class="coupon-btn">Aplicar</button>
            </div>

            <div class="summary-line-row">
                <span>Subtotal (@Model.Itens.Sum(i => i.Quantidade) itens)</span>
                <span>R$ @Model.Total.ToString("N2")</span>
            </div>

            <div class="summary-line-row">
                <span>Frete</span>
                <span class="free-shipping">Grátis</span>
            </div>

            <div class="summary-total-row">
                <span>Total</span>
                <span class="total-amount">R$ @Model.Total.ToString("N2")</span>
            </div>

            <a asp-page="/Checkout" class="btn btn-primary btn-checkout-full">Finalizar compra</a>
            <a asp-page="/Index" class="btn-continue-link">Continuar comprando</a>
        </div>
    }
    else
    {
        <div class="empty-cart-card" style="margin: 40px auto;">
            <p>Seu carrinho está vazio.</p>
            <a asp-page="/Index" class="btn btn-primary">Ver Catálogo</a>
        </div>
    }
</div>