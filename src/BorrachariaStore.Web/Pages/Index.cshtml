<section id="ofertas" class="destaques-section">
  <div class="destaques-head">
    <div>
      @if (!string.IsNullOrWhiteSpace(Model.Termo))
      {
        <h2>Resultados da busca</h2>
        <p>Exibindo pneus encontrados para "@Model.Termo".</p>
      }
      else
      {
        <h2>Pneus em destaque</h2>
        <p>Seleção com os melhores preços da semana.</p>
      }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Termo))
    {
      <a asp-page="/Index" class="destaques-link">Limpar busca</a>
    }
    else
    {
      <a asp-page="/Catalogo" asp-route-apenasOfertas="true" class="destaques-link">Ver todos →</a>
    }
  </div>

  <div class="destaques-grid">
    @if (!string.IsNullOrEmpty(Model.ErroCarregamento))
    {
      <div class="catalogo-error-box">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <p class="error-title">Catálogo temporariamente indisponível</p>
        <p class="error-desc">@Model.ErroCarregamento</p>
        <a asp-page="/Index" class="btn-error-retry">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
          </svg>
          Tentar novamente
        </a>
      </div>
    }
    else if (Model.Produtos != null && Model.Produtos.Any())
    {
      var listaOfertas = Model.Produtos.Where(p => p.EmPromocao || (p.PrecoOriginal.HasValue && p.PrecoOriginal.Value > p.Preco)).Take(4).ToList();
      var listaExibicao = string.IsNullOrWhiteSpace(Model.Termo) ? (listaOfertas.Any() ? listaOfertas : Model.Produtos.Take(4)) : Model.Produtos;
      @foreach (var pneu in listaExibicao)
      {
        var emOferta = pneu.EmPromocao || (pneu.PrecoOriginal.HasValue && pneu.PrecoOriginal.Value > pneu.Preco);
        string? badgePromo = null;
        if (emOferta)
        {
          if (pneu.PorcentagemDesconto.HasValue && pneu.PorcentagemDesconto.Value > 0)
          {
            badgePromo = $"-{pneu.PorcentagemDesconto.Value}% OFF";
          }
          else if (pneu.PrecoOriginal.HasValue && pneu.PrecoOriginal.Value > pneu.Preco)
          {
            var pct = (int)Math.Round((1m - (pneu.Preco / pneu.PrecoOriginal.Value)) * 100m);
            badgePromo = pct > 0 ? $"-{pct}% OFF" : "OFERTA";
          }
          else
          {
            badgePromo = "OFERTA";
          }
        }
        var fotosJson = (pneu.Fotos != null && pneu.Fotos.Any())
          ? System.Text.Json.JsonSerializer.Serialize(pneu.Fotos)
          : "[]";
        var fotoPrincipal = pneu.Fotos?.FirstOrDefault();

        <article class="destaque-card" id="p-@pneu.Id"
                 data-id="@pneu.Id"
                 data-marca="@pneu.Marca"
                 data-nome="@pneu.Nome"
                 data-descricao="@pneu.Descricao"
                 data-aro="@pneu.Aro"
                 data-medida="@pneu.Medida"
                 data-categoria="@pneu.Categoria"
                 data-estoque="@pneu.Estoque"
                 data-preco="@pneu.Preco.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))"
                 data-preco-original="@(pneu.PrecoOriginal.HasValue && pneu.PrecoOriginal > pneu.Preco ? pneu.PrecoOriginal.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) : "")"

                 data-fotos='@fotosJson'
                 data-badge-promo="@badgePromo">
          <div class="destaque-thumb" onclick="abrirDetalhes(this)" style="cursor: pointer;">
            @if (!string.IsNullOrEmpty(badgePromo))
            {
              <span class="destaque-badge-oferta">@badgePromo</span>
            }
            else
            {
              <span class="destaque-badge-aro">Aro @pneu.Aro</span>
            }
            @if (!string.IsNullOrWhiteSpace(fotoPrincipal))
            {
              <img src="@fotoPrincipal" alt="@pneu.Marca @pneu.Nome" class="destaque-img" onerror="this.onerror=null; this.src='/images/logo/logo-icon.png'; this.classList.add('destaque-img-fallback');" />
            }
            else
            {
              <img src="/images/logo/logo-icon.png" alt="@pneu.Marca @pneu.Nome" class="destaque-img destaque-img-fallback" />
            }
          </div>
          <div class="destaque-body">
            <p class="destaque-brand">@pneu.Marca</p>
            <h3 class="destaque-title" onclick="abrirDetalhes(this)" style="cursor: pointer;">@pneu.Nome</h3>
            <p class="destaque-measure">@pneu.Medida</p>
            <div class="destaque-footer">
              @if (pneu.PrecoOriginal.HasValue && pneu.PrecoOriginal.Value > pneu.Preco && pneu.PrecoOriginal.Value > 0)
              {
                <p class="destaque-old-price">de R$ @pneu.PrecoOriginal.Value.ToString("N2")</p>
              }
              <div class="destaque-price-row">
                <strong class="destaque-price">R$ @pneu.Preco.ToString("N2")</strong>
                <span class="destaque-rating">★ @((pneu.Avaliacao ?? 4.8).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))</span>
              </div>
            </div>
            <form method="post" asp-page-handler="AdicionarAoCarrinho" asp-route-produtoId="@pneu.Id" class="destaque-form">
              <button type="submit" class="destaque-add-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                  <circle cx="9" cy="21" r="1" />
                  <circle cx="20" cy="21" r="1" />
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                </svg>
                Adicionar
              </button>
            </form>
          </div>
        </article>
      }
    }
    else
    {
      <div class="empty-filter-box">
        <p>Nenhum produto encontrado com os filtros atuais.</p>
        <a asp-page="/Index">Ver todos os pneus</a>
      </div>
    }
  </div>
</section>

