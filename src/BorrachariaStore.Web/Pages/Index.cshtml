@page
@model BorrachariaStore.Web.Pages.IndexModel
@{
  ViewData["Title"] = "Início";
}

@if (TempData["MensagemSucesso"] != null)
{
  <div class="toast-success-banner">
    <div class="toast-message">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12" />
      </svg>
      <span>@TempData["MensagemSucesso"]</span>
    </div>
    <a asp-page="/Carrinho" class="toast-btn">
      Ver Carrinho
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  </div>
}

<section class="hero-carousel-section">
  <div class="hero-carousel-container">
    <div class="hero-carousel">
      <div class="hero-slide active">
        <div class="hero-slide-content">
          <span class="hero-badge">15% OFF</span>
          <p class="hero-subtitle">PIRELLI · 205/55 R16</p>
          <h1 class="hero-title">Semana do pneu Pirelli</h1>
          <p class="hero-old-price">de R$ 549,90</p>
          <div class="hero-price-row">
            <strong class="hero-price">R$ 467,41</strong>
            <span class="hero-price-label">no Pix</span>
          </div>
          <p class="hero-installments">ou 10x de R$ 46,74 sem juros</p>
          <form method="post" asp-page-handler="ComprarAgora" asp-route-termo="Pirelli Cinturato P7">
            <button type="submit" class="btn btn-primary hero-btn">Comprar agora</button>
          </form>
        </div>
        <a asp-page="/Catalogo" asp-route-termo="Pirelli Cinturato P7" class="hero-slide-media">
          <img src="~/images/hero/hero-tire.png" alt="Pirelli Cinturato P7" />
          <span class="hero-media-badge">Pirelli Cinturato P7</span>
        </a>
      </div>

      <div class="hero-slide">
        <div class="hero-slide-content">
          <span class="hero-badge">PREÇO ESPECIAL</span>
          <p class="hero-subtitle">MICHELIN · 205/55 R16</p>
          <h1 class="hero-title">Michelin para viajar tranquilo</h1>
          <p class="hero-old-price">de R$ 679,90</p>
          <div class="hero-price-row">
            <strong class="hero-price">R$ 612,00</strong>
            <span class="hero-price-label">no Pix</span>
          </div>
          <p class="hero-installments">ou 10x de R$ 61,20 sem juros</p>
          <form method="post" asp-page-handler="ComprarAgora" asp-route-termo="Michelin Primacy 4">
            <button type="submit" class="btn btn-primary hero-btn">Comprar agora</button>
          </form>
        </div>
        <a asp-page="/Catalogo" asp-route-termo="Michelin Primacy 4" class="hero-slide-media">
          <img src="~/images/hero/tire-michelin.png" alt="Michelin Primacy 4" />
          <span class="hero-media-badge">Michelin Primacy 4</span>
        </a>
      </div>

      <div class="hero-slide">
        <div class="hero-slide-content">
          <span class="hero-badge">OFERTA</span>
          <p class="hero-subtitle">GOODYEAR · 195/55 R15</p>
          <h1 class="hero-title">Goodyear com frete grátis</h1>
          <p class="hero-old-price">de R$ 458,90</p>
          <div class="hero-price-row">
            <strong class="hero-price">R$ 389,90</strong>
            <span class="hero-price-label">no Pix</span>
          </div>
          <p class="hero-installments">ou 10x de R$ 38,99 sem juros</p>
          <form method="post" asp-page-handler="ComprarAgora" asp-route-termo="Goodyear EfficientGrip">
            <button type="submit" class="btn btn-primary hero-btn">Comprar agora</button>
          </form>
        </div>
        <a asp-page="/Catalogo" asp-route-termo="Goodyear EfficientGrip" class="hero-slide-media">
          <img src="~/images/hero/tire-goodyear.png" alt="Goodyear EfficientGrip" />
          <span class="hero-media-badge">Goodyear EfficientGrip</span>
        </a>
      </div>
    </div>

    <button type="button" class="carousel-arrow prev" id="heroPrevBtn" aria-label="Anterior">‹</button>
    <button type="button" class="carousel-arrow next" id="heroNextBtn" aria-label="Próximo">›</button>

    <div class="carousel-dots">
      <button type="button" class="dot active" data-index="0"></button>
      <button type="button" class="dot" data-index="1"></button>
      <button type="button" class="dot" data-index="2"></button>
    </div>
  </div>
</section>

