<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — BorrachariaStore</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <a asp-page="/Index" class="logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/>
                </svg>
            </div>
            Borracharia<span class="accent">Store</span>
        </a>
        <nav class="main-nav">
            <a asp-page="/Index">Catálogo</a>
            <a asp-page="/Carrinho">Carrinho</a>
            <a asp-page="/Admin/Index">Admin</a>
        </nav>
        <div class="nav-icons">
            <a asp-page="/Carrinho" class="cart-wrap" title="Ver Carrinho">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
            </a>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <div class="footer-grid">
            <div>
                <div class="logo" style="margin-bottom:12px;">
                    <div class="logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                            <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                    </div>
                    Borracharia<span class="accent">Store</span>
                </div>
                <p style="font-size:13px;max-width:280px;line-height:1.6;">Pneus de qualidade com entrega rápida e o suporte que você precisa para escolher o modelo certo.</p>
            </div>
            <div>
                <h5>Loja</h5>
                <ul>
                    <li><a asp-page="/Index">Catálogo</a></li>
                    <li><a asp-page="/Carrinho">Carrinho</a></li>
                </ul>
            </div>
            <div>
                <h5>Administração</h5>
                <ul>
                    <li><a asp-page="/Admin/Index">Painel de Produtos</a></li>
                </ul>
            </div>
            <div>
                <h5>Pagamento</h5>
                <ul>
                    <li>Cartão de crédito</li>
                    <li>PIX</li>
                    <li>Boleto</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year BorrachariaStore. Todos os direitos reservados.</span>
            <span>Pagamento 100% seguro e criptografado</span>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
