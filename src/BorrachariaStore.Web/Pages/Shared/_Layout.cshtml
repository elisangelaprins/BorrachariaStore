@inject BorrachariaStore.Web.Services.CarrinhoService CarrinhoService
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — BorrachariaStore</title>
    <link rel="icon" type="image/png" href="~/images/logo/logo-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (!Context.Request.Path.Value?.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) ?? true)
    {
        <div class="top-bar">
            <div class="top-bar-track">
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18.5" r="2.5"/><circle cx="7" cy="18.5" r="2.5"/></svg>Frete grátis acima de R$ 800</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>10x sem juros no cartão</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>Compra 100% segura</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>Entrega rápida para todo o Brasil</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18.5" r="2.5"/><circle cx="7" cy="18.5" r="2.5"/></svg>Frete grátis acima de R$ 800</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>10x sem juros no cartão</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>Compra 100% segura</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>Entrega rápida para todo o Brasil</span>
            </div>
        </div>
    }
    <header>
        <div class="header-container">
            <a asp-page="/Index" class="logo">
                <img src="~/images/logo/logo-full.png" alt="PNEU Store" class="logo-img" />
            </a>
            <form method="get" asp-page="/Index" class="header-search">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
                </svg>
                <input type="text" name="termo" placeholder="Busque por marca, modelo ou medida" value="@Context.Request.Query["termo"]" />
            </form>
            <div class="nav-icons">
                <a asp-page="/Carrinho" class="cart-wrap" title="Ver Carrinho">
                    <svg class="icon" viewBox="0 0 24 24">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                    @if (CarrinhoService.Itens.Any())
                    {
                        <span class="cart-badge">@CarrinhoService.Itens.Sum(i => i.Quantidade)</span>
                    }
                </a>
            </div>
        </div>
        <nav class="sub-nav">
            <div class="sub-nav-container">
                <a asp-page="/Index" class="sub-nav-link active">Início</a>
                <a asp-page="/Index" class="sub-nav-link">Todos os pneus</a>
                <a href="#ofertas" class="sub-nav-link text-primary">Ofertas</a>
                <a href="#sobre" class="sub-nav-link">Atendimento</a>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-grid">
            <div>
                <img src="~/images/logo/logo-full.png" alt="PNEU Store" style="height: 62px; width: auto; margin-bottom: 16px; display: block;" />
                <p style="font-size: 13px; max-width: 290px; line-height: 1.6; color: #94a3b8; margin: 0;">
                    Pneus originais com garantia de fábrica, entrega rápida para todo o Brasil e pagamento facilitado.
                </p>
            </div>
            <div>
                <h5>Atendimento</h5>
                <ul class="footer-contact-list">
                    <li>
                        <strong style="color: #f8fafc; display: block;">(11) 98765-4321</strong>
                        <span style="font-size: 12px; color: #64748b;">Seg. a Sex. 08h às 18h</span>
                    </li>
                    <li>
                        <span style="font-size: 12px; color: #64748b;">Sábados das 08h às 13h</span>
                    </li>
                    <li>
                        <a href="mailto:contato@borrachariastore.com.br" style="color: #60a5fa;">contato@borrachariastore.com.br</a>
                    </li>
                </ul>
            </div>
            <div>
                <h5>Institucional</h5>
                <ul>
                    <li><a asp-page="/Index">Catálogo de pneus</a></li>
                    <li><a href="#ofertas">Ofertas da semana</a></li>
                    <li><a asp-page="/Carrinho">Meu carrinho</a></li>
                    <li><span style="color: #64748b; font-size: 13px;">Política de devolução</span></li>
                    <li><span style="color: #64748b; font-size: 13px;">Termos de garantia</span></li>
                </ul>
            </div>
            <div>
                <h5>Formas de pagamento</h5>
                <div class="footer-pay-grid">
                    <div class="footer-pay-chip">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                        <span>Cartão em até 10x</span>
                    </div>
                    <div class="footer-pay-chip">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
                        <span>PIX instantâneo</span>
                    </div>
                    <div class="footer-pay-chip">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5v14"/><path d="M7 5v14"/><path d="M11 5v14"/><path d="M15 5v14"/><path d="M18 5v14"/><path d="M20 5v14"/></svg>
                        <span>Boleto bancário</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div>
                <span>© @DateTime.Now.Year Borracharia Store Ltda • CNPJ: 12.345.678/0001-90 • Todos os direitos reservados.</span>
            </div>
            <div class="footer-bottom-right">
                <span class="footer-security-seal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Compra 100% segura • SSL
                </span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
