<div id="detalhesOverlay" class="detalhes-overlay" onclick="fecharDetalhes()"></div>

<aside id="detalhesDrawer" class="detalhes-drawer" aria-hidden="true">
    <div class="detalhes-header">
        <div>
            <span id="detalheMarca" class="detalhes-brand"></span>
            <h2 id="detalheNome" class="detalhes-title"></h2>
        </div>
        <button type="button" class="detalhes-close-btn" onclick="fecharDetalhes()" aria-label="Fechar">&times;</button>
    </div>

    <div class="detalhes-body">
        <div class="detalhes-gallery">
            <div class="detalhes-media">
                <span id="detalheBadgePromo" class="detalhes-badge-promo" style="display: none;"></span>
                <span id="detalheBadgeAro" class="detalhes-badge-aro"></span>
                <img id="detalheImg" src="" alt="" class="detalhes-img" onerror="this.onerror=null; this.src='/images/logo/logo-icon.png';" />
                <button type="button" id="detalheGalleryPrev" class="detalhes-nav-btn prev" onclick="mudarFotoDetalhes(-1)" aria-label="Foto anterior" style="display: none;">
                    &#10094;
                </button>
                <button type="button" id="detalheGalleryNext" class="detalhes-nav-btn next" onclick="mudarFotoDetalhes(1)" aria-label="Próxima foto" style="display: none;">
                    &#10095;
                </button>
            </div>
            <div id="detalhesThumbs" class="detalhes-thumbs" style="display: none;"></div>
        </div>

        <div class="detalhes-specs-grid">
            <div class="detalhes-spec-card">
                <span class="detalhes-spec-label">Aro</span>
                <strong id="detalheAro" class="detalhes-spec-val"></strong>
            </div>
            <div class="detalhes-spec-card">
                <span class="detalhes-spec-label">Medida</span>
                <strong id="detalheMedida" class="detalhes-spec-val"></strong>
            </div>
            <div class="detalhes-spec-card">
                <span class="detalhes-spec-label">Categoria</span>
                <strong id="detalheCategoria" class="detalhes-spec-val"></strong>
            </div>
            <div class="detalhes-spec-card">
                <span class="detalhes-spec-label">Disponibilidade</span>
                <strong id="detalheEstoque" class="detalhes-spec-val"></strong>
            </div>
        </div>

        <div class="detalhes-section">
            <h3 class="detalhes-section-title">Descrição do Produto</h3>
            <p id="detalheDescricao" class="detalhes-desc"></p>
        </div>
    </div>

    <div class="detalhes-footer">
        <div class="detalhes-prices">
            <span id="detalhePrecoAntigo" class="detalhes-old-price" style="display: none;"></span>
            <div class="detalhes-current-price-row">
                <strong id="detalhePreco" class="detalhes-price"></strong>
                <span class="detalhes-price-label">no Pix</span>
            </div>
            <span id="detalheParcelas" class="detalhes-installments"></span>
        </div>

        <form method="post" action="/Catalogo?handler=AdicionarAoCarrinho" id="detalhesAddForm">
            <input type="hidden" name="produtoId" id="detalheProdutoId" value="" />
            <button type="submit" class="detalhes-add-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                </svg>
                Adicionar ao Carrinho
            </button>
        </form>
    </div>
</aside>
