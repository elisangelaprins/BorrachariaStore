<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BorrachariaStore.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aula 3: instalar via "dotnet add package MongoDB.Driver" -->
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mock Data (Aula 2) copiado para a pasta de saída -->
    <None Update="Data\MockData\produtos.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
